{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "event-hub",
  "prefix": "app",
  "projectType": "application",
  "sourceRoot": "apps/event-hub/src",
  "tags": ["type:app", "scope:event-hub"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/event-hub",
        "browser": "apps/event-hub/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/event-hub/tsconfig.app.json",
        "assets": [
          { "glob": "**/*", "input": "apps/event-hub/public" },
          {
            "glob": "**/*",
            "input": "node_modules/@taiga-ui/icons/src",
            "output": "assets/taiga-ui/icons"
          }
        ],
        "styles": [
          "node_modules/@taiga-ui/styles/taiga-ui-theme.less",
          "node_modules/@taiga-ui/styles/taiga-ui-fonts.less",
          "apps/event-hub/styles/style.scss"
        ],
        "stylePreprocessorOptions": { "includePaths": ["apps/event-hub/styles/mixins"] }
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "500kb", "maximumError": "1mb" },
            { "type": "anyComponentStyle", "maximumWarning": "4kb", "maximumError": "8kb" }
          ],
          "outputHashing": "all"
        },
        "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": { "proxyConfig": "apps/event-hub/proxy.conf.mjs" },
      "configurations": {
        "production": { "buildTarget": "event-hub:build:production" },
        "development": { "buildTarget": "event-hub:build:development" }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": { "buildTarget": "event-hub:build" }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "event-hub:build",
        "port": 4200,
        "staticFilePath": "dist/apps/event-hub/browser",
        "spa": true
      }
    }
  }
}
